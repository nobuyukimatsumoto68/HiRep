GLB_T = 48
GLB_X = 24
GLB_Y = 24
GLB_Z = 24
NP_T = 4
NP_X = 1
NP_Y = 1
NP_Z = 1

N_REP = 1

rlx_level = 1
rlx_seed = 20261103

// Wilson action, 1 heatbath + 4 overrelaxation sweeps per update
beta = 11.045
anisotropy = 1.0
nhb = 1
nor = 4

// run control: measurements at n > therm with n % ObsInterval == 0
// (ObsInterval * (nhb + nor) must be a multiple of 10 for exact resume)
